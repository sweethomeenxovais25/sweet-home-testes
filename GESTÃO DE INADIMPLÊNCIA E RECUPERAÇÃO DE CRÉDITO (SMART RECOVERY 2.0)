                DATA_CORTE_LEGADO = pd.to_datetime("2026-02-01")
                
                # --- 1. HIGIENIZAÇÃO DE DADOS ---
                df_cobranca = df_fin.copy()
                df_cobranca['SALDO_NUM'] = df_cobranca['SALDO DEVEDOR'].apply(limpar_v)
                
